def _xr_call(method: str, path: str, payload: dict | None = None) -> tuple[dict, str]:
    url = XR_BASE + path
    headers = {"Accept": "application/json", "User-Agent": XR_UA}
    if XROCKET_TOKEN:
        headers["Authorization"] = "Bearer " + XROCKET_TOKEN
    body = None
    if payload is not None:
        body = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=25) as resp:
            raw = resp.read().decode("utf-8", "replace")
        return json.loads(raw or "{}"), ""
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace")[:400]
        return {}, f"HTTP {exc.code}: {detail}"
    except Exception as exc:  # сеть, таймаут, кривой JSON
        return {}, f"{type(exc).__name__}: {exc}"


async def xr_create(uid: int, code: str, amount: float, title: str) -> tuple[str, int, str]:
    """Создаёт счёт, возвращает (ссылка, id, ошибка)."""
    if not XROCKET_TOKEN:
        return "", 0, "XROCKET_TOKEN не задан"
    payload = {
        "priceAmount": f"{amount:.2f}",
        "priceCurrency": XR_CURRENCY,
        "numPayments": 1,
        "description": f"PsyhoSn · {title} · id {uid}"[:1000],
        "expiresIn": 86400 * 1000,
        "clientInvoiceId": f"{uid}-{code}-{int(time.time())}-{uuid.uuid4().hex[:8]}",
        "data": {"uid": str(uid), "plan": code},
    }
    data, err = await asyncio.to_thread(_xr_call, "POST", "/api/v1/invoices", payload)
    if err:
        return "", 0, err
    item = data.get("data") or data
    link = (item.get("links") or {}).get("telegramBotLink") or item.get("link") or ""
