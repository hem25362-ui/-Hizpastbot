def _fetch_rate() -> tuple[float, str]:
    url = "https://www.cbr-xml-daily.ru/daily_json.js"
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as r:
        payload = json.loads(r.read().decode("utf-8", "replace"))
    value = float(payload["Valute"]["USD"]["Value"])
    if value <= 0:
        raise ValueError("курс нулевой")
    return value, "ЦБ РФ"


def _fetch_rate_sync() -> tuple[float, str]:
    try:
        return _fetch_rate()
    except Exception:
        return 0.0, ""


async def usd_rate() -> float:
    now = time.time()
    if RATE["usd_rub"] and now - RATE["at"] < RATE_TTL:
        return RATE["usd_rub"]
    value, source = await asyncio.to_thread(_fetch_rate_sync)
    if value:
        RATE.update({"usd_rub": value, "at": now, "source": source})
        return value
    if RATE["usd_rub"]:
        return RATE["usd_rub"]
    RATE.update({"usd_rub": 81.5, "at": now, "source": "запасной"})
    return 81.5


