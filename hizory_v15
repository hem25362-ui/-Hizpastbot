    rec = user_rec(uid)
    rec["sub_until"] = 0
    rec["sub_plan"] = ""
    save_data()


def sub_line(uid: int) -> str:
    left = sub_left(uid)
    if not left:
        return "подписки нет"
    if left > 30 * 86400 * 365:
        return "навсегда"
    days, rem = divmod(left, 86400)
    hours = rem // 3600
    if days:
        return f"ещё {days} дн. {hours} ч."
    return f"ещё {hours} ч."


