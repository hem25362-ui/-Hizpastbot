def build_letter(
    method_key: str, url: str, details: str, target_key: str = "page"
) -> tuple[str, str]:
    method = METHODS[method_key]
    target = TARGETS.get(target_key, TARGETS["page"])
    body = method["body"].format(url=url, details=details_line(details))
    body = body.replace(
        "Hello,\n\n", f"Hello,\n\nI am reporting a Telegram {target['word']}.\n\n", 1
    )
    return f"{method['subject']} ({target['word']})", body


def _send_one(account: dict, subject: str, body: str) -> str:
    msg = EmailMessage()
    msg["From"] = account["email"]
    msg["To"] = ABUSE_EMAIL
    msg["Subject"] = subject
    msg["Date"] = formatdate(localtime=True)
    msg["Message-ID"] = make_msgid(domain=account["email"].split("@")[-1])
    msg.set_content(body)
    context = ssl.create_default_context()
    with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, context=context, timeout=25) as smtp:
        smtp.login(account["email"], account["password"])
        smtp.send_message(msg)
    return account["email"]


