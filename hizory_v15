    sent = 0
    errors: list[str] = []
    boxes = accounts()
    for index, account in enumerate(boxes):
        try:
            _send_one(account, subject, body)
            sent += 1
        except smtplib.SMTPAuthenticationError:
            errors.append("не пустило по паролю приложения — перевыпусти пароль Gmail")
        except Exception as exc:
            errors.append(f"{type(exc).__name__}: {exc}"[:200])
        if index < len(boxes) - 1:
            time.sleep(GAP)
    return sent, errors


