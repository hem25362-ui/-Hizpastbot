def _split(cand: str) -> tuple[str, str]:
    """Домен и путь. Схема необязательна, www. и хвост с ?# отбрасываются."""
    parts = urllib.parse.urlsplit(cand if "//" in cand else "https://" + cand)
    host = (parts.hostname or "").lower()
    if host.startswith("www."):
        host = host[4:]
    path = urllib.parse.unquote(parts.path or "").strip("/")
    return host, path


def _tg(path: str, target: str) -> tuple[str, str]:
    if not path:
        return "", "Это только домен. Пример: t.me/name или @name"
    if target == "page":
        return "", "Для страницы нужна ссылка telegra.ph или graph.org"
    first = path.split("/")[0]
    ok = (
        HANDLE_RE.match(first)
        or INVITE_RE.match(first)
        or JOINCHAT_RE.match(path)
        or PRIVATE_RE.match(path)
    )
    if not ok:
        return "", "Имя в ссылке не телеграмное: 4–32 символа, латиница, цифры и _"
    return "https://t.me/" + path, ""


def _ph(host: str, path: str, target: str) -> tuple[str, str]:
    if not path:
        return "", "Это только домен. Пример: telegra.ph/Some-Page-11-05"
    if not PH_SLUG_RE.match(path):
        return "", "В ссылке нет названия страницы"
    if target and target != "page":
        return "", "Для бота, канала и группы нужна ссылка t.me"
    return f"https://{host}/{path}", ""


def validate_url(text: str, target: str = "") -> tuple[str, str]:
    """Принимает t.me/name, https://t.me/name, @name, name, tg://…, telegra.ph/…"""
    raw = (text or "").strip().strip("<>«»\"'` \t\r\n")
    if not raw:
        return "", "Пустая ссылка."

    # tg://resolve?domain=name
    if raw.lower().startswith("tg://"):
        q = urllib.parse.parse_qs(urllib.parse.urlsplit(raw).query)
        domain = (q.get("domain") or [""])[0].strip()
        if not domain:
            return "", "В tg:// нет имени. Пример: t.me/name"
        raw = "@" + domain
        if not HANDLE_RE.match(domain):
            return "", "Имя в ссылке не телеграмное: 4–32 символа, латиница, цифры и _"

    # вокруг ссылки мог быть текст — берём первый похожий кусок
    if not (
        raw.lower().startswith(("http://", "https://", "@"))
        or _split(raw)[0] in ALLOWED_HOSTS
        or HANDLE_RE.match(raw)
    ):
        found = LINK_TOKEN_RE.search(raw)
        if not found:
            return "", "Не разобрал ссылку. Пример: t.me/name или @name"
        raw = found.group(0).strip(".,;:!?)»\"'")

    if raw.startswith("@"):
        name = raw[1:].strip("/")
        if not HANDLE_RE.match(name):
            return "", "Имя в ссылке не телеграмное: 4–32 символа, латиница, цифры и _"
        return _tg(name, target)

    host, path = _split(raw)
    if host in TG_HOSTS:
        return _tg(path, target)
    if host in PH_HOSTS:
        return _ph(host, path, target)
    if not path and HANDLE_RE.match(raw):
        return _tg(raw, target)
    return "", "Принимаю t.me, telegram.me, telegra.ph и graph.org"


