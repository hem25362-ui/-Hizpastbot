async def do_send(query, context) -> None:
    data = context.user_data
    method_key = data.get("method")
    url = data.get("url", "")
    if method_key not in METHODS or not url:
        await query.answer("Данные потерялись, начни заново", show_alert=True)
        return

    uid = query.from_user.id
    store = DATA["users"].setdefault(str(uid), {})
    last = float(store.get("last_sent", 0) or 0)
    wait = COOLDOWN - (time.time() - last)
    if wait > 0:
        await query.answer(f"Подожди {int(wait) + 1} с перед следующей жалобой", show_alert=True)
        return
    if not accounts():
        await query.answer("Ящики не настроены: EMAIL_1/EMAIL_PASS_1 в окружении", show_alert=True)
        return

    target_key = data.get("target", "page")
    subject, body = build_letter(
        method_key, url, data.get("details", ""), target_key
    )
    await query.answer("Отправляю…")
    await query.edit_message_text("⏳ Отправляю жалобу…")
    sent, errors = await asyncio.to_thread(send_letters, subject, body)

    if sent:
        store["last_sent"] = time.time()
        bump_reports(uid, method_key)
        total = len(accounts())
        context.user_data.clear()
        await query.edit_message_text(
            text_log(method_key, url, sent, total, target_key),
            reply_markup=kb_after_send(),
            parse_mode=HTML,
        )
        return

    reason = errors[0] if errors else "неизвестная ошибка"
    await query.edit_message_text(
        "⚠️ <b>Не отправилось</b>\n\n"
        f"причина — <i>{reason}</i>\n\n"
        f"Если пароль приложения отозван — его надо перевыпустить. "
        f"Руками: {SUPPORT}",
        reply_markup=kb_back_to("m:menu", "‹ В меню"),
        parse_mode=HTML,
