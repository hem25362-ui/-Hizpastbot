async def activate(bot, item: dict) -> int:
    """Закрывает платёж и включает подписку. Возвращает дату окончания."""
    item["status"] = "paid"
    item["paid_at"] = int(time.time())
    if item["plan"] == DONATE_CODE:
        item["sub_until"] = 0
        save_data()
        try:
            await bot.send_message(
                int(item["uid"]),
                "❤️ <b>Спасибо за поддержку</b>\n\n"
                f"получено — <b>${float(item.get('usd', 0)):.2f}</b>",
                parse_mode=HTML,
            )
        except Exception:
            pass
        for admin in ADMIN_IDS:
            try:
                await bot.send_message(
                    admin,
                    f"❤️ донат · ${float(item.get('usd', 0)):.2f} · id <code>{item['uid']}</code>",
                    parse_mode=HTML,
                )
            except Exception:
                pass
        return 0
    until = grant(int(item["uid"]), str(item["plan"]))
    item["sub_until"] = until
    save_data()
    plan = PLANS.get(item["plan"], {})
    until_str = "бессрочно" if until > FOREVER_TS - 86400 else time.strftime(
        "%d.%m.%Y", time.localtime(until)
    )
    try:
        await bot.send_message(
            int(item["uid"]),
            "🎉 <b>Подписка активна</b>\n\n"
            f"тариф — <b>{plan.get('label', item['plan'])}</b>\n"
            f"доступ до — {until_str}",
            parse_mode=HTML,
        )
    except Exception:
        pass
    for admin in ADMIN_IDS:
        try:
            await bot.send_message(
                admin,
                f"💰 оплата · {plan.get('label')} · {rub_str(int(item['rub']))} · "
                f"id <code>{item['uid']}</code>",
                parse_mode=HTML,
            )
        except Exception:
            pass
    return until


async def auto_check_job(context: ContextTypes.DEFAULT_TYPE) -> None:
    """Раз в минуту проверяет неоплаченные счета и выдаёт подписку сама."""
    if not XROCKET_TOKEN or not DATA.get("payments"):
        return
    now = int(time.time())
    changed = False
    for item in list(DATA["payments"]):
        if item.get("status") != "active":
            continue
        if now - int(item.get("at", 0)) > 25 * 3600:
            item["status"] = "expired"
            changed = True
            continue
        status, err = await xr_status(int(item.get("invoice") or 0))
        if err or status not in PAID_STATES:
            continue
        await activate(context.bot, item)
        changed = True
    if changed:
        save_data()


async def on_check(query, context, raw_id: str) -> None:
    try:
        inv_id = int(raw_id)
    except ValueError:
        await query.answer("Кривой номер счёта", show_alert=True)
        return
    item = payment_find_invoice(inv_id)
    if item is None:
        await query.answer("Счёт не найден", show_alert=True)
        return
    if item.get("status") == "paid":
        await query.answer("Уже оплачен", show_alert=True)
        return
    await query.answer("Проверяю…")
    status, err = await xr_status(inv_id)
    if err:
        await query.answer(f"Не смог проверить: {err[:100]}", show_alert=True)
        return
    if status != "paid":
        await query.answer(f"Статус: {status or 'неизвестен'}. Ещё не оплачен.", show_alert=True)
        return
    await activate(context.bot, item)
    if item["plan"] == DONATE_CODE:
        await query.edit_message_text(
            "❤️ <b>Чек закрыт</b>\n\n"
            f"получено — <b>${float(item.get('usd', 0)):.2f}</b>\n\n"
            "<i>Спасибо, что помогаешь проекту.</i>",
            reply_markup=kb_back_to("m:menu", "‹ В меню"),
            parse_mode=HTML,
        )
        return
    plan = PLANS.get(item["plan"], {})
    until_str = "бессрочно" if int(item.get("sub_until", 0)) > FOREVER_TS - 86400 else (
        time.strftime("%d.%m.%Y", time.localtime(int(item.get("sub_until", 0))))
    )
    await query.edit_message_text(
        "🎉 <b>Оплата получена</b>\n\n"
        f"тариф — <b>{plan.get('label', item['plan'])}</b>\n"
        f"доступ до — {until_str}\n\n"
        "<i>Спасибо. Жалобы можно отправлять прямо сейчас.</i>",
        reply_markup=kb_after_send(),
        parse_mode=HTML,
    )


# ---------- админ ----------
async def on_admin(query, context, action: str) -> None:
    rate = await usd_rate()
    if action == "stats":
        await query.answer()
        await query.edit_message_text(
            admin_home(rate), reply_markup=kb_admin(), parse_mode=HTML
        )
        return

    if action == "users":
        await query.answer()
        users = sorted(DATA["users"].values(), key=lambda u: -int(u.get("last_at", 0) or 0))
        lines = ["👥 <b>Пользователи</b>", ""]
        now = time.time()
        for rec in users[:20]:
            mark = "🟢" if int(rec.get("sub_until", 0)) > now else "⚪️"
            name = rec.get("name") or "без имени"
            lines.append(
                f"{mark} <code>{rec.get('id')}</code> · {name} · "
                f"жалоб {int(rec.get('reports', 0))}"
            )
        if not users:
            lines.append("<i>пока пусто</i>")
        lines.append(f"\nвсего: {len(users)}")
        await query.edit_message_text(
            "\n".join(lines), reply_markup=kb_back_to("a:stats", "‹ В админку"), parse_mode=HTML
        )
        return

    if action == "pays":
        await query.answer()
        pays = DATA["payments"][-10:][::-1]
        lines = ["🧾 <b>Последние платежи</b>", ""]
        for item in pays:
            when = time.strftime("%d.%m %H:%M", time.localtime(int(item.get("at", 0))))
            lines.append(
                f"{when} · <code>{item.get('uid')}</code> · "
                f"{plan_label(str(item.get('plan')))} · "
                f"{rub_str(int(item.get('rub', 0)))} · {item.get('status')}"
            )
        if not pays:
            lines.append("<i>платежей ещё не было</i>")
        total = sum(int(p.get("rub", 0)) for p in DATA["payments"] if p.get("status") == "paid")
        lines.append(f"\nоплачено всего: <b>{rub_str(total)}</b>")
        await query.edit_message_text(
            "\n".join(lines), reply_markup=kb_back_to("a:stats", "‹ В админку"), parse_mode=HTML
        )
        return

    if action in ("grant", "revoke", "cast"):
        context.user_data["admin"] = {"step": action}
        await query.answer()
        if action == "grant":
            hint = "Пришли: <code>ID тариф</code>\nтарифы: " + ", ".join(PLAN_ORDER)
        elif action == "revoke":
            hint = "Пришли ID пользователя, у кого забрать подписку."
        else:
            hint = "Пришли текст рассылки одним сообщением."
        await query.edit_message_text(
            f"✍️ <b>Жду ввод</b>\n\n{hint}",
            reply_markup=kb_back_to("a:stats", "‹ Отмена"),
            parse_mode=HTML,
        )
        return

    await query.answer()


async def admin_text(update: Update, context: ContextTypes.DEFAULT_TYPE) -> bool:
    """Обрабатывает ввод админа. True — сообщение съедено."""
    uid = update.effective_user.id
    if uid not in ADMIN_IDS:
        return False
    pending = context.user_data.get("admin")
    if not isinstance(pending, dict):
        return False
    step = pending.get("step")
    text = (update.message.text or "").strip()
    context.user_data.pop("admin", None)

    if step == "grant":
        parts = text.split()
        if len(parts) != 2 or not TG_ID_RE.match(parts[0]) or parts[1] not in PLANS:
            await update.message.reply_text(
                "Не понял. Формат: <code>436426811 month</code>\nтарифы: "
                + ", ".join(PLAN_ORDER),
                parse_mode=HTML,
            )
            return True
        target, code = int(parts[0]), parts[1]
        until = grant(target, code)
        await update.message.reply_text(
            f"🎁 выдал <code>{target}</code> тариф <b>{PLANS[code]['label']}</b> "
            f"до {time.strftime('%d.%m.%Y', time.localtime(until))}",
            parse_mode=HTML,
        )
        try:
            await context.bot.send_message(
                target,
                f"🎁 Тебе выдали подписку <b>{PLANS[code]['label']}</b>.\n"
                f"Доступ до {time.strftime('%d.%m.%Y', time.localtime(until))}.",
                parse_mode=HTML,
            )
        except Exception:
            pass
        return True

    if step == "revoke":
        if not TG_ID_RE.match(text):
            await update.message.reply_text("Нужен числовой ID.")
            return True
        revoke(int(text))
        await update.message.reply_text(f"🚫 забрал подписку у <code>{text}</code>", parse_mode=HTML)
        return True

    if step == "cast":
        if len(text) < 3:
            await update.message.reply_text("Слишком коротко.")
            return True
        sent = failed = 0
        for key in list(DATA["users"].keys()):
            try:
                await context.bot.send_message(int(key), text, parse_mode=HTML)
                sent += 1
            except Exception:
                failed += 1
            await asyncio.sleep(0.05)
        await update.message.reply_text(f"📣 ушло: {sent}, не дошло: {failed}")
        return True

    return False


# ---------- тексты ----------
async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if await admin_text(update, context):
        return

    text = (update.message.text or "").strip()
    step = context.user_data.get("step")

    if step == "url":
        url, error = validate_url(text, context.user_data.get("target", ""))
        if error:
            await update.message.reply_text(f"⚠️ {error}")
            return
        context.user_data["url"] = url
        context.user_data["step"] = "details"
        key = context.user_data.get("method", "other")
        await update.message.reply_text(
            text_details(key), reply_markup=kb_details(key), parse_mode=HTML
        )
        return

    if step == "details":
        context.user_data["details"] = text[:600]
        context.user_data["step"] = "confirm"
        key = context.user_data.get("method", "other")
        await update.message.reply_text(
            text_preview(
                key, context.user_data.get("url", ""), text,
                context.user_data.get("target", "page"),
            ),
            reply_markup=kb_confirm(),
            parse_mode=HTML,
        )
        return

    if step == "donate":
        raw = text.replace("$", "").replace(",", ".").replace(" ", "").strip()
        try:
            usd = round(float(raw), 2)
        except ValueError:
            await update.message.reply_text("Нужна сумма числом: например 5 или 2.5")
            return
        if not (DONATE_MIN <= usd <= DONATE_MAX):
            await update.message.reply_text(f"Сумма от ${DONATE_MIN:g} до ${DONATE_MAX:g}")
            return
        context.user_data["step"] = "menu"
        rate = await usd_rate()
        link, inv_id, err = await make_donate(update.effective_user.id, usd, rate)
        if err:
            await update.message.reply_text(
                "⚠️ <b>Чек не создался</b>\n\n" f"<i>{err[:300]}</i>", parse_mode=HTML
            )
            return
        await update.message.reply_text(
            text_donate_invoice(usd, rate),
            reply_markup=kb_invoice(link, inv_id, "m:profile", "‹ В профиль"),
            parse_mode=HTML,
        )
        return

    await update.message.reply_text(
        "Не понял. /start — меню, /admin — админка."
    )


def main() -> None:
    if not BOT_TOKEN:
        raise SystemExit("BOT_TOKEN не задан")
    load_data()
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("cancel", cmd_cancel))
    app.add_handler(CommandHandler("admin", cmd_admin))
    app.add_handler(CallbackQueryHandler(on_callback))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    if app.job_queue is not None:
        app.job_queue.run_repeating(auto_check_job, interval=60, first=20)
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
