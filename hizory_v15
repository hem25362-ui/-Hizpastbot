def grant(uid: int, code: str) -> int:
    plan = PLANS.get(code)
    if plan is None:
        return 0
    rec = user_rec(uid)
    base = max(int(time.time()), int(rec.get("sub_until", 0)))
    if plan["days"] is None:
        rec["sub_until"] = FOREVER_TS
    else:
        rec["sub_until"] = base + plan["days"] * 86400
    rec["sub_plan"] = code
    save_data()
    return rec["sub_until"]


